<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.emailapp.client.view.DraftEditorViewController"
      spacing="10" padding="20">

    <GridPane vgap="10" hgap="10">
        <Label text="To:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="recipientsField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

        <Label text="Subject:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="subjectField" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
    </GridPane>

    <TextArea fx:id="bodyArea" VBox.vgrow="ALWAYS" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Save Draft" onAction="#handleSave"/>
        <Button text="Send" onAction="#handleSend"/>
    </HBox>

</VBox>