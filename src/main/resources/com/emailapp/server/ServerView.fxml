<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.emailapp.server.view.ServerViewController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">
    <HBox spacing="10" alignment="CENTER">
        <Label text="Mail Server Log" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
        <Button fx:id="toggleServerButton" text="Stop Server" onAction="#handleToggleServer"/>
    </HBox>
    <TextArea fx:id="logTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
</VBox>