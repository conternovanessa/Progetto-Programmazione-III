<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.emailapp.server.view.ServerViewController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Port:"/>
        <Label fx:id="portLabel" prefWidth="100"/>
        <Button fx:id="startStopButton" text="Start Server" onAction="#handleStartStop"/>
    </HBox>
    <TextArea fx:id="logTextArea" VBox.vgrow="ALWAYS" editable="false"/>
</VBox>
